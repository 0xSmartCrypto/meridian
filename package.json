    "paper:process": "tsx src/paper/cli.ts process",
    "paper:close": "tsx src/paper/cli.ts close",
    "paper:snapshot": "tsx src/paper/snapshot.ts",
    "paper:history": "tsx src/paper/snapshot.ts --history",
    "paper:reset": "tsx src/paper/cli.ts reset",
    "paper:export": "tsx src/paper/cli.ts export",
    "paper:open": "tsx src/paper/hook.ts open",
    "paper:monitor": "tsx src/paper/monitor.ts",
    "paper:monitor:watch": "tsx src/paper/monitor.ts --watch",
    "paper:implied": "tsx src/paper/implied-analysis.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "pm2": "^6.0.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "main": "index.js",
  "keywords": [
